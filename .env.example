APP_URL=http://localhost:3000
# Generate TWO different random secrets using scripts/generate-secrets.mjs.
APP_SECRET=
ADMIN_PASSWORD=
# Public read access, including downloads. Editing always requires admin login.
PUBLIC_READ=true
# Supabase > Connect > Transaction pooler (port 6543). URL-encode the password.
DATABASE_URL=
# Optional Supabase CA certificate; use literal \n for line breaks.
DATABASE_CA_CERT=
# Only for a local PostgreSQL development server: DATABASE_SSL=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
